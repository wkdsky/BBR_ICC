+// The DQC implementation uses Goertzel plus the complete N01--N16 tree.
+// ICC has only per-ACK samples, so this keeps the source's three regime
+// outputs while using its documented time-domain fallback signals.
+FBBRCC::WaveformClassification FBBRCC::ClassifyCurrentFBBR(Time now) const {
+  (void)now;
+  Bandwidth drate_min, drate_mean, drate_max;
+  Time srtt_min, srtt_mean, srtt_max;
+  if (!ComputeWindowStats(drate_min, drate_mean, drate_max,
+                          srtt_min, srtt_mean, srtt_max) ||
+      !min_rtt_initialized_) {
+    return WaveformClassification::kInconclusive;
+  }
+  const Time rtprop = MinRtt();
+  if (!(rtprop > 0) || !std::isfinite(rtprop)) {
+    return WaveformClassification::kInconclusive;
+  }
+  const Time qdelay = std::max<Time>(0, srtt_mean - rtprop);
+  const Time q_high = std::max<Time>(2.0, 0.10 * rtprop);
+  const Time q_low = std::max<Time>(1.0, 0.03 * rtprop);
+  const double relative_drate_swing =
+      drate_mean > 0 ? (drate_max - drate_min) / drate_mean : 0.0;
+  const Time srtt_swing = std::max<Time>(0, srtt_max - srtt_min);
+
+  if (qdelay > q_high || srtt_swing > 0.25 * rtprop) {
+    return WaveformClassification::kOverload;
+  }
+  if (qdelay < q_low && relative_drate_swing < 0.25) {
+    return WaveformClassification::kUnderload;
+  }
+  return WaveformClassification::kFullLoad;
+}
+
+void FBBRCC::ApplyCurrentFBBR(WaveformClassification cls) {
+  Bandwidth drate_min, drate_mean, drate_max;
+  Time srtt_min, srtt_mean, srtt_max;
+  if (!ComputeWindowStats(drate_min, drate_mean, drate_max,
+                          srtt_min, srtt_mean, srtt_max)) {
+    return;
+  }
+
+  const char* rule = "INCONCLUSIVE";
+  Bandwidth next_baseline = current_injection_baseline_bw_;
+  switch (cls) {
+    case WaveformClassification::kFullLoad:
+      next_baseline = drate_mean;
+      trusted_bw_ = drate_mean;
+      trusted_bw_valid_ = drate_mean > 0 && std::isfinite(drate_mean);
+      rule = "REGIME_II_DELIVERED_MEAN";
+      break;
+    case WaveformClassification::kUnderload:
+      next_baseline = drate_max;
+      rule = "REGIME_I_DELIVERED_MAX";
+      break;
+    case WaveformClassification::kOverload: {
+      const Bandwidth raw_candidate = drate_min;
+      service_fair_raw_regime_candidate_ = raw_candidate;
+      next_baseline = IsServiceFair()
+          ? ApplyServiceFairOverloadLimit(raw_candidate) : raw_candidate;
+      service_fair_final_regime_candidate_ = next_baseline;
+      rule = IsServiceFair() ? "REGIME_III_SERVICE_FAIR" : "REGIME_III_DELIVERED_MIN";
+      break;
+    }
+    default:
+      break;
+  }
+
+  if (cls != WaveformClassification::kInconclusive) {
+    last_valid_regime_seen_this_cruise_ = true;
+    last_valid_regime_this_cruise_ = cls;
+  }
+  if (next_baseline > 0 && std::isfinite(next_baseline)) {
+    current_injection_baseline_bw_ = std::max(minimum_pacing_rate_, next_baseline);
+  }
+  current_amplitude_ = GetCurrentAmplitude();
+
+  fprintf(stderr, "fbbr_regime,%d,%llu,%s,%.4f,%.4f,%.4f,%.3f,%.3f,%.3f\n",
+          flow_id, static_cast<unsigned long long>(cruise_id_), rule,
+          drate_min * 8.0 / 1000.0, drate_mean * 8.0 / 1000.0,
+          drate_max * 8.0 / 1000.0, srtt_min, srtt_mean, srtt_max);
+}
+
+void FBBRCC::ResetServiceFairState() {
+  service_fair_service_rate_ = 0;
+  service_fair_previous_service_rate_ = 0;
+  service_fair_qdelay_ewma_ms_ = 0;
+  service_fair_previous_qdelay_ewma_ms_ = 0;
+  service_fair_qdelay_trend_ms_ = 0;
+  service_fair_cycle_count_ = 0;
+  service_fair_qdelay_valid_ = false;
+  service_fair_previous_qdelay_valid_ = false;
+  service_fair_service_history_valid_ = false;
+  service_fair_last_update_cruise_id_ = -1;
+  service_fair_action_ = ServiceFairAction::kNotRun;
+  service_fair_service_rate_change_ = 0;
+  service_fair_alpha_ = 0;
+  service_fair_raw_regime_candidate_ = 0;
+  service_fair_final_regime_candidate_ = 0;
+}
+
+void FBBRCC::UpdateServiceFairSignals(Time now) {
+  if (!IsServiceFair() || mode_ != Bbr2Mode::PROBE_BW ||
+      !min_rtt_initialized_) {
+    return;
+  }
+  const Time rtprop = MinRtt();
+  if (!(rtprop > 0) || !std::isfinite(rtprop)) {
+    return;
+  }
+  if (latest_srtt_ms_ > 0 && std::isfinite(latest_srtt_ms_)) {
+    const Time sample = std::max<Time>(0, latest_srtt_ms_ - rtprop);
+    if (!service_fair_qdelay_valid_) {
+      service_fair_qdelay_ewma_ms_ = sample;
+      service_fair_qdelay_valid_ = true;
+    } else {
+      service_fair_qdelay_ewma_ms_ =
+          std::max<Time>(0, (7.0 * service_fair_qdelay_ewma_ms_ + sample) / 8.0);
+    }
+  }
+
+  service_fair_service_history_valid_ = false;
+  ByteCount delivered = 0;
+  if (!ComputeDeliveredInWindow(now, rtprop, &delivered) ||
+      !(delivered > 0) || !std::isfinite(delivered)) {
+    return;
+  }
+  const Bandwidth service_rate = delivered / rtprop;
+  if (service_rate > 0 && std::isfinite(service_rate)) {
+    service_fair_service_rate_ = service_rate;
+    service_fair_service_history_valid_ = true;
+  }
+}
+
+FBBRCC::Bandwidth FBBRCC::ApplyServiceFairOverloadLimit(
+    Bandwidth raw_candidate) const {
+  if (!IsServiceFair() || !(raw_candidate > 0) ||
+      !std::isfinite(raw_candidate) ||
+      !(current_injection_baseline_bw_ > 0) ||
+      !std::isfinite(current_injection_baseline_bw_)) {
+    return raw_candidate;
+  }
+  const Bandwidth yield_cap = 0.995 * current_injection_baseline_bw_;
+  Bandwidth candidate = std::min(raw_candidate, yield_cap);
+  if (service_fair_service_history_valid_ &&
+      service_fair_service_rate_ > 0 &&
+      std::isfinite(service_fair_service_rate_)) {
+    const Bandwidth service_floor = std::min(yield_cap,
+                                             0.98 * service_fair_service_rate_);
+    candidate = std::max(candidate, service_floor);
+  }
+  return std::min(yield_cap, candidate);
+}
+
+const char* FBBRCC::ServiceFairActionName() const {
+  switch (service_fair_action_) {
+    case ServiceFairAction::kAdditiveIncrease: return "ADDITIVE_INCREASE";
+    case ServiceFairAction::kMultiplicativeDecrease: return "MULTIPLICATIVE_DECREASE";
+    case ServiceFairAction::kHold: return "HOLD";
+    case ServiceFairAction::kSkipInvalidHistory: return "SKIP_INVALID_HISTORY";
+    default: return "NOT_RUN";
+  }
+}
+
+void FBBRCC::EmitServiceFairTrace(const char* event,
+                                  WaveformClassification classification) const {
+  if (!IsServiceFair()) {
+    return;
+  }
+  const char* classification_name = "INCONCLUSIVE";
+  if (classification == WaveformClassification::kFullLoad) {
+    classification_name = "FULL_LOAD";
+  } else if (classification == WaveformClassification::kUnderload) {
+    classification_name = "UNDERLOAD";
+  } else if (classification == WaveformClassification::kOverload) {
+    classification_name = "OVERLOAD";
+  }
+  fprintf(stderr,
+          "fbbr_servicefair,%d,%llu,%.3f,%s,%s,%s,%.4f,%.3f,%.3f,%.4f,%.6f,%.4f,%.4f\n",
+          flow_id, static_cast<unsigned long long>(cruise_id_), cur_tick,
+          event == nullptr ? "UNKNOWN" : event, classification_name,
+          ServiceFairActionName(),
+          current_injection_baseline_bw_ * 8.0 / 1000.0,
+          service_fair_qdelay_ewma_ms_, service_fair_qdelay_trend_ms_,
+          service_fair_service_rate_ * 8.0 / 1000.0,
+          service_fair_service_rate_change_,
+          service_fair_alpha_ * 8.0 / 1000.0,
+          service_fair_final_regime_candidate_ * 8.0 / 1000.0);
+}
+
+void FBBRCC::RunServiceFairCycleUpdate(Time now) {
+  (void)now;
+  if (!IsServiceFair() || mode_ != Bbr2Mode::PROBE_BW ||
+      service_fair_last_update_cruise_id_ ==
+          static_cast<int64_t>(cruise_id_)) {
+    return;
+  }
+  service_fair_last_update_cruise_id_ = static_cast<int64_t>(cruise_id_);
+  service_fair_qdelay_trend_ms_ = 0;
+  service_fair_service_rate_change_ = 0;
+  service_fair_raw_regime_candidate_ = current_injection_baseline_bw_;
+  service_fair_final_regime_candidate_ = current_injection_baseline_bw_;
+
+  const Time rtprop = MinRtt();
+  if (!(current_injection_baseline_bw_ > 0) ||
+      !std::isfinite(current_injection_baseline_bw_) || !(rtprop > 0) ||
+      !std::isfinite(rtprop) || !service_fair_qdelay_valid_ ||
+      !service_fair_service_history_valid_ ||
+      !(service_fair_service_rate_ > 0) ||
+      !std::isfinite(service_fair_service_rate_)) {
+    service_fair_action_ = ServiceFairAction::kSkipInvalidHistory;
+    EmitServiceFairTrace("CYCLE_UPDATE", WaveformClassification::kInconclusive);
+    return;
+  }
+
+  // alpha = 0.5 * MSS / RTprop in ICC bytes/ms units.
+  service_fair_alpha_ = 0.5 * kDefaultTCPMSS / rtprop;
+  if (!(service_fair_alpha_ > 0) || !std::isfinite(service_fair_alpha_)) {
+    service_fair_action_ = ServiceFairAction::kSkipInvalidHistory;
+    EmitServiceFairTrace("CYCLE_UPDATE", WaveformClassification::kInconclusive);
+    return;
+  }
+
+  if (service_fair_previous_qdelay_valid_) {
+    service_fair_qdelay_trend_ms_ = service_fair_qdelay_ewma_ms_ -
+                                    service_fair_previous_qdelay_ewma_ms_;
+  }
+  if (service_fair_previous_service_rate_ > 0 &&
+      std::isfinite(service_fair_previous_service_rate_)) {
+    service_fair_service_rate_change_ =
+        service_fair_service_rate_ / service_fair_previous_service_rate_ - 1.0;
+  }
+
+  const Time q_low = std::max<Time>(1.0, 0.03 * rtprop);
+  const Time q_high = std::max<Time>(2.0, 0.10 * rtprop);
+  Bandwidth next_baseline = current_injection_baseline_bw_;
+  if (service_fair_qdelay_ewma_ms_ > q_high ||
+      (service_fair_previous_qdelay_valid_ &&
+       service_fair_qdelay_trend_ms_ > q_low)) {
+    next_baseline = std::min(current_injection_baseline_bw_,
+                             std::max(minimum_pacing_rate_,
+                                      0.995 * current_injection_baseline_bw_));
+    service_fair_action_ = ServiceFairAction::kMultiplicativeDecrease;
+  } else if (service_fair_qdelay_ewma_ms_ < q_low) {
+    next_baseline = current_injection_baseline_bw_ + service_fair_alpha_;
+    const Bandwidth max_bw = MaxBandwidth();
+    if (max_bw > 0 && std::isfinite(max_bw)) {
+      next_baseline = std::min(next_baseline,
+                               std::max(current_injection_baseline_bw_, max_bw));
+    }
+    service_fair_action_ = ServiceFairAction::kAdditiveIncrease;
+  } else {
+    service_fair_action_ = ServiceFairAction::kHold;
+  }
+
+  current_injection_baseline_bw_ =
+      std::max(minimum_pacing_rate_, next_baseline);
+  service_fair_final_regime_candidate_ = current_injection_baseline_bw_;
+  service_fair_previous_qdelay_ewma_ms_ = service_fair_qdelay_ewma_ms_;
+  service_fair_previous_qdelay_valid_ = true;
+  service_fair_previous_service_rate_ = service_fair_service_rate_;
+  ++service_fair_cycle_count_;
+  EmitServiceFairTrace("CYCLE_UPDATE", WaveformClassification::kInconclusive);
+}
+
+void FBBRCC::ApplyServiceFairTrustedBaselineCorrection() {
+  if (!IsServiceFair() || !trusted_bw_valid_ || !(trusted_bw_ > 0) ||
+      !std::isfinite(trusted_bw_) || !(current_injection_baseline_bw_ > 0)) {
+    return;
+  }
+  Bandwidth corrected = trusted_bw_;
+  if (last_valid_regime_seen_this_cruise_ &&
+      last_valid_regime_this_cruise_ == WaveformClassification::kUnderload) {
+    corrected = std::max(corrected, current_injection_baseline_bw_);
+    const Bandwidth max_bw = MaxBandwidth();
+    if (max_bw > 0 && std::isfinite(max_bw)) {
+      corrected = std::min(corrected, max_bw);
+    }
+  } else if (last_valid_regime_seen_this_cruise_ &&
+             last_valid_regime_this_cruise_ == WaveformClassification::kOverload) {
+    corrected = std::min(corrected, current_injection_baseline_bw_);
+    if (service_fair_service_history_valid_ && service_fair_service_rate_ > 0) {
+      corrected = std::max(corrected,
+                           std::min(current_injection_baseline_bw_,
+                                    0.98 * service_fair_service_rate_));
+    }
+  } else if (service_fair_action_ == ServiceFairAction::kAdditiveIncrease ||
+             service_fair_action_ == ServiceFairAction::kMultiplicativeDecrease) {
+    corrected = current_injection_baseline_bw_;
+  }
+  trusted_bw_ = std::max(minimum_pacing_rate_, corrected);
+  trusted_bw_valid_ = trusted_bw_ > 0 && std::isfinite(trusted_bw_);
+  service_fair_final_regime_candidate_ = trusted_bw_;
+  EmitServiceFairTrace("TRUSTED_PUBLISH",
+                       last_valid_regime_seen_this_cruise_
+                           ? last_valid_regime_this_cruise_
+                           : WaveformClassification::kInconclusive);
+}
+
+void FBBRCC::FinalizeCruise() {
+  if (!UsesServiceEnvelope() || !(current_injection_baseline_bw_ > 0) ||
+      !std::isfinite(current_injection_baseline_bw_)) {
+    return;
+  }
+  if (!trusted_bw_valid_ ||
+      (last_valid_regime_seen_this_cruise_ &&
+       last_valid_regime_this_cruise_ != WaveformClassification::kFullLoad)) {
+    trusted_bw_ = current_injection_baseline_bw_;
+    trusted_bw_valid_ = true;
+  }
+  if (IsServiceFair()) {
+    ApplyServiceFairTrustedBaselineCorrection();
+  }
+}
