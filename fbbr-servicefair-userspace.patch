+
+FBBRCC::Bandwidth FBBRCC::ComputeFBBRBasePacing(Time now_ms) const {
+  Bandwidth native = NativePacing();
+  if (!(native > 0) || !std::isfinite(native)) {
+    native = minimum_pacing_rate_;
+  }
+  const bool use_waveform_baseline =
+      in_cruise_ && current_injection_baseline_bw_ > 0.0 && IsCruisePhase();
+  if (!use_waveform_baseline) {
+    return native;
+  }
+
+  Bandwidth base = current_injection_baseline_bw_;
+  if (ShouldOscillate()) {
+    const Bandwidth amplitude = GetCurrentAmplitude();
+    const Bandwidth offset = amplitude * TriangleWave(now_ms);
+    base += std::min<Bandwidth>(0.0, offset);
+  }
+  if (!(base > 0) || !std::isfinite(base)) {
+    base = current_injection_baseline_bw_;
+  }
+  return std::max(minimum_pacing_rate_, base);
+}
+
+void FBBRCC::RecordRateTargets(Time now, Bandwidth target_rate,
+                               Bandwidth base_target_rate) {
+  if (!UsesServiceEnvelope() || !(target_rate > 0) ||
+      !std::isfinite(target_rate)) {
+    return;
+  }
+  if (!(base_target_rate > 0) || !std::isfinite(base_target_rate)) {
+    base_target_rate = target_rate;
+  }
+  base_target_rate = std::min(base_target_rate, target_rate);
+
+  if (!rate_history_.empty() && now < rate_history_.back().timestamp_ms) {
+    rate_history_.clear();
+  }
+  if (!rate_history_.empty() &&
+      now == rate_history_.back().timestamp_ms) {
+    rate_history_.back().target_rate = target_rate;
+    rate_history_.back().base_target_rate = base_target_rate;
+  } else {
+    rate_history_.push_back({now, target_rate, base_target_rate});
+  }
+
+  const Time retention_ms = 60000.0;
+  while (rate_history_.size() > 1 &&
+         (rate_history_.size() > 20000 ||
+          now - rate_history_.front().timestamp_ms > retention_ms)) {
+    rate_history_.pop_front();
+  }
+}
+
+void FBBRCC::RecordDeliveredPoint(Time now, ByteCount cumulative_delivered) {
+  if (!UsesServiceEnvelope() || !(cumulative_delivered >= 0) ||
+      !std::isfinite(cumulative_delivered)) {
+    return;
+  }
+  if (!delivered_history_.empty()) {
+    DeliveredPoint& last = delivered_history_.back();
+    if (cumulative_delivered < last.cumulative_delivered || now < last.timestamp_ms) {
+      delivered_history_valid_ = false;
+      return;
+    }
+    if (now == last.timestamp_ms) {
+      last.cumulative_delivered = cumulative_delivered;
+    } else {
+      delivered_history_.push_back({now, cumulative_delivered});
+    }
+  } else {
+    delivered_history_.push_back({now, cumulative_delivered});
+  }
+
+  const Time retention_ms = 60000.0;
+  while (delivered_history_.size() > 1 &&
+         (delivered_history_.size() > 20000 ||
+          now - delivered_history_.front().timestamp_ms > retention_ms)) {
+    delivered_history_.pop_front();
+  }
+}
+
+bool FBBRCC::HasFullRateHistory(Time now, Time rtprop) const {
+  if (rate_history_.empty() || !(rtprop > 0) || !std::isfinite(rtprop) ||
+      now < rtprop) {
+    return false;
+  }
+  const Time window_start = now - rtprop;
+  return rate_history_.front().timestamp_ms <= window_start &&
+         rate_history_.back().timestamp_ms <= now;
+}
+
+bool FBBRCC::ComputeRateIntegrals(Time now, Time rtprop, ByteCount* planned,
+                                  ByteCount* positive_probe_credit) const {
+  if (planned != nullptr) *planned = 0;
+  if (positive_probe_credit != nullptr) *positive_probe_credit = 0;
+  if (!HasFullRateHistory(now, rtprop) || planned == nullptr ||
+      positive_probe_credit == nullptr) {
+    return false;
+  }
+
+  const Time window_start = now - rtprop;
+  ByteCount plan = 0;
+  ByteCount credit = 0;
+  for (size_t i = 0; i < rate_history_.size(); ++i) {
+    const RateSegment& segment = rate_history_[i];
+    const Time segment_end = i + 1 < rate_history_.size()
+        ? std::min(now, rate_history_[i + 1].timestamp_ms)
+        : now;
+    const Time segment_start = std::max(window_start, segment.timestamp_ms);
+    if (segment_end <= segment_start) {
+      continue;
+    }
+    if (!(segment.target_rate > 0) || !std::isfinite(segment.target_rate) ||
+        !(segment.base_target_rate > 0) ||
+        !std::isfinite(segment.base_target_rate)) {
+      return false;
+    }
+    const Time duration = segment_end - segment_start;
+    plan += segment.target_rate * duration;
+    credit += std::max<Bandwidth>(0.0,
+                                  segment.target_rate - segment.base_target_rate) *
+              duration;
+  }
+  if (!(plan > 0) || !std::isfinite(plan) || !std::isfinite(credit)) {
+    return false;
+  }
+  *planned = plan;
+  *positive_probe_credit = std::max<ByteCount>(0, credit);
+  return true;
+}
+
+bool FBBRCC::ComputeDeliveredInWindow(Time now, Time rtprop,
+                                      ByteCount* delivered) const {
+  if (delivered != nullptr) *delivered = 0;
+  if (!delivered_history_valid_ || delivered == nullptr ||
+      delivered_history_.empty() || !(rtprop > 0) ||
+      !std::isfinite(rtprop) || now < rtprop) {
+    return false;
+  }
+  const Time window_start = now - rtprop;
+  bool has_anchor = false;
+  bool has_current = false;
+  ByteCount anchor = 0;
+  ByteCount current = 0;
+  for (const DeliveredPoint& point : delivered_history_) {
+    if (point.timestamp_ms <= window_start) {
+      has_anchor = true;
+      anchor = point.cumulative_delivered;
+    }
+    if (point.timestamp_ms <= now) {
+      has_current = true;
+      current = point.cumulative_delivered;
+    } else {
+      break;
+    }
+  }
+  if (!has_anchor || !has_current || current < anchor) {
+    return false;
+  }
+  *delivered = current - anchor;
+  return std::isfinite(*delivered);
+}
+
+FBBRCC::ByteCount FBBRCC::ComputeFBBRInflightCap(Time now, bool* active) {
+  if (active != nullptr) *active = false;
+  envelope_cap_active_ = false;
+  last_envelope_bytes_ = 0;
+  last_inflight_cap_bytes_ = 0;
+  if (!UsesServiceEnvelope() || mode_ != Bbr2Mode::PROBE_BW ||
+      !min_rtt_initialized_) {
+    return cwnd_;
+  }
+
+  const Time rtprop = MinRtt();
+  ByteCount planned = 0;
+  ByteCount positive_credit = 0;
+  if (!ComputeRateIntegrals(now, rtprop, &planned, &positive_credit)) {
+    return cwnd_;
+  }
+
+  ByteCount delivered = 0;
+  const bool service_valid = ComputeDeliveredInWindow(now, rtprop, &delivered);
+  ByteCount envelope = planned;
+  if (service_valid) {
+    const ByteCount maximum = std::numeric_limits<ByteCount>::max() / 4.0;
+    const ByteCount budget = delivered > maximum - positive_credit
+        ? maximum : delivered + positive_credit;
+    envelope = std::min(planned, budget);
+  }
+  if (!(envelope > 0) || !std::isfinite(envelope)) {
+    return cwnd_;
+  }
+
+  const ByteCount maximum = std::numeric_limits<ByteCount>::max() / 4.0;
+  ByteCount cap = std::min(maximum, envelope + std::max<ByteCount>(0, max_ack_height_));
+  cap = std::max(cwnd_min, cap);
+  if (kDefaultTCPMSS > 0 && cap < maximum - kDefaultTCPMSS) {
+    cap = std::ceil(cap / kDefaultTCPMSS) * kDefaultTCPMSS;
+  }
+  if (!(cap > 0) || !std::isfinite(cap)) {
+    return cwnd_;
+  }
+
+  envelope_cap_active_ = true;
+  last_envelope_bytes_ = envelope;
+  last_inflight_cap_bytes_ = cap;
+  if (active != nullptr) *active = true;
+  return cap;
+}
