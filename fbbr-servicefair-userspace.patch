+void FBBRCC::onACK(int ack, double receiver_timestamp, double sent_time,
+                   int delta_class) {
+  const ByteCount delivered_before = total_bytes_acked_;
+  BBR2CC::onACK(ack, receiver_timestamp, sent_time, delta_class);
+  if (total_bytes_acked_ == delivered_before) {
+    return;
+  }
+
+  const Time now = current_timestamp();
+  if (UsesServiceEnvelope()) {
+    RecordDeliveredPoint(now, total_bytes_acked_);
+  }
+  if (IsServiceFair()) {
+    UpdateServiceFairSignals(now);
+  }
+
+  // BBR2 publishes before this post-ACK history update. Publish once more so
+  // the ICC sender observes the current envelope rather than a one-ACK-old cap.
+  PublishToICCOutputs();
 }
 
